# .env.template — agesci-campania-web-frontend (Caddy)
# Copiato in .env da scripts/installa.sh. NON committare .env.

# Email per l'account ACME di Let's Encrypt (avvisi di scadenza/problemi sui certificati)
ACME_EMAIL=

# Directory ACME. Commentata = Let's Encrypt produzione (default nel Caddyfile).
# Non lasciarla definita vuota: Caddy userebbe il valore vuoto invece del default.
# Per le prove (DNS non ancora propagato, test ripetuti) decommentare lo staging, che non ha
# i limiti di emissione ma produce certificati non riconosciuti dai browser:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
